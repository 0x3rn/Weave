{
  "name": "weave",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:apply-schema": "node --env-file=.env.local scripts/apply-neon-schema.mjs",
    "db:apply-exchange-workspace": "node --env-file=.env.local scripts/apply-exchange-workspace-schema.mjs",
    "test:exchange-workflow": "node --env-file=.env.local scripts/verify-exchange-workflow.mjs",
    "db:migrate:firestore": "node --env-file=.env.local scripts/migrate-firestore-to-neon.mjs",
    "db:verify-migration": "node --env-file=.env.local scripts/verify-firestore-neon.mjs",
    "db:verify-cutover": "node --env-file=.env.local scripts/verify-neon-cutover.mjs",
    "storage:verify": "node --env-file=.env.local scripts/verify-neon-storage.mjs",
    "storage:roundtrip": "node --env-file=.env.local scripts/verify-neon-storage-roundtrip.mjs",
    "storage:migrate": "node --env-file=.env.local scripts/migrate-firebase-storage-to-neon.mjs",
    "storage:rewrite-references": "node --env-file=.env.local scripts/rewrite-storage-references.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/ua-parser-js": "^0.7.39",
    "country-list": "^2.4.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "jose": "6.2.12",
    "lucide-react": "^1.23.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.1.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "recharts": "^3.9.2",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/country-list": "^2.1.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    }
  }
}
