rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function conversationMember(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function exchangeMember(exchangeId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/exchanges/$(exchangeId)).data.participants;
    }

    match /conversations/{conversationId} {
      allow read: if conversationMember(conversationId);
      allow write: if false;
    }

    match /messages/{messageId} {
      allow read: if conversationMember(resource.data.conversationId);
      allow create: if conversationMember(request.resource.data.conversationId)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /exchanges/{exchangeId}/messages/{messageId} {
      allow read: if exchangeMember(exchangeId);
      allow create: if exchangeMember(exchangeId)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
